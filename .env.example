# ===== Cấu hình pipeline VCB OCR =====
# Đổi "bộ não" = bật/tắt comment 1 KHỐI (4 dòng), không sửa code.
# Mỗi khối gồm cả DPI/MAX_SIDE vì GPU khoẻ dùng ảnh nét hơn Mac.

# --- UAT / GPU 32GB: vLLM + Qwen3-VL-8B (ĐANG BẬT) ---
# Yêu cầu: vLLM đủ mới (hỗ trợ kiến trúc Qwen3-VL), đã chạy:
#   vllm serve Qwen/Qwen3-VL-8B-Instruct --max-model-len 16384 --port 8000
OCR_BASE_URL=http://localhost:8000/v1
OCR_MODEL=Qwen/Qwen3-VL-8B-Instruct
PDF_DPI=300
MAX_SIDE=2048

# --- DEV / Mac: Ollama + Qwen2.5-VL-3B (bỏ comment 4 dòng dưới + comment khối trên khi chạy local) ---
# OCR_BASE_URL=http://localhost:11434/v1
# OCR_MODEL=qwen2.5vl-3b-16k
# PDF_DPI=250
# MAX_SIDE=1024

OCR_API_KEY=dummy
