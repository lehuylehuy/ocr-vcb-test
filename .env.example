# ===== Cấu hình pipeline VCB OCR =====
# Copy file này thành .env rồi chỉnh. Đổi "bộ não" = đổi 2 dòng, không sửa code.

# --- Bộ não DEV: Ollama trên Mac (mặc định) ---
OCR_BASE_URL=http://localhost:11434/v1
OCR_MODEL=qwen2.5vl:3b

# --- Bộ não TEST: vLLM + Qwen2.5-VL trên GPU thuê (bỏ comment khi có) ---
# OCR_BASE_URL=http://localhost:8000/v1
# OCR_MODEL=ocr-extractor

OCR_API_KEY=dummy

# Render PDF: DPI và cạnh dài tối đa của ảnh gửi vào VLM
PDF_DPI=250
MAX_SIDE=2048
